---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { business } from '../data/site';
---

<BaseLayout
  title={`Thank You | ${business.name}`}
  description="Your quote request has been received. We will get back to you within one business day."
  noindex
>
  <Header />
  <main id="main" class="bg-ivory-100">
    <div class="container-page flex min-h-[60vh] flex-col items-center justify-center py-24 text-center">
      <span class="inline-flex h-16 w-16 items-center justify-center rounded-full bg-olive-100 text-olive-700">
        <svg aria-hidden="true" viewBox="0 0 24 24" class="h-8 w-8" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </span>
      <h1 class="mt-6 font-display text-5xl tracking-tight text-olive-900">Request received</h1>
      <p class="mt-4 max-w-md text-lg leading-relaxed text-olive-700">
        Thank you for reaching out. We will get back to you within one business day.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a
          href={`tel:${business.phoneHref}`}
          class="rounded-full bg-olive-600 px-7 py-3.5 font-semibold text-ivory-50 transition hover:bg-olive-700"
        >
          Call {business.phone}
        </a>
        <a
          href="/"
          class="rounded-full border border-olive-300 px-7 py-3.5 font-semibold text-olive-800 transition hover:bg-ivory-50"
        >
          Back to home
        </a>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

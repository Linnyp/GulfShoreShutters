---
interface Props {
  name: string;
  class?: string;
}

const { name, class: className = 'h-5 w-5' } = Astro.props;

const paths: Record<string, string> = {
  shutter: 'M4 3h16v18H4zM4 8h16M4 12h16M4 16h16M12 3v18',
  arch: 'M4 21V11a8 8 0 0 1 16 0v10M4 15h16M12 3v18',
  shield: 'M12 3l8 3v6c0 5-3.4 8.3-8 9-4.6-.7-8-4-8-9V6z',
  ruler: 'M3 15L15 3l6 6L9 21zM7 11l2 2M11 7l2 2M15 11l2 2',
  tag: 'M3 12V5a2 2 0 0 1 2-2h7l9 9-9 9zM7.5 7.5h.01',
  phone: 'M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.58 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.46.57 3.6a1 1 0 0 1-.25 1z',
  badge: 'M12 3l2.4 4.9 5.4.8-3.9 3.8.9 5.4-4.8-2.6-4.8 2.6.9-5.4L4.2 8.7l5.4-.8zM8 19v3l4-2 4 2v-3',
};

const d = paths[name] ?? paths.badge;
---

<svg
  aria-hidden="true"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
>
  <path d={d}></path>
</svg>

---
import { Image } from 'astro:assets';
import heroImage from '../assets/hero-lake-window.jpg';
import { business, pricing, manufacturer, warranty, leadTime } from '../data/site';

/* Four concrete facts. For a company with no review history, specificity is the only
   thing that reads as established — so the hero leads with numbers, not adjectives.
   Each fact is split into its own lines so the two-column mobile grid breaks where the
   phrase does, rather than wherever the column happens to run out. */
const proof = [
  [`$${pricing.low}–$${pricing.high} per sq ft,`, 'installed'],
  [`Built in ${manufacturer.city} by a`, `${manufacturer.yearsInBusiness}-year manufacturer`],
  [`${warranty.wood} warranty`, 'on wood'],
  [leadTime, 'from deposit'],
];
---

{/* No bottom border: the SectionDivider in index.astro carries the transition now. */}
<section class="relative isolate bg-ivory-100">
  <div class="container-page grid items-center gap-12 py-14 md:py-20 lg:grid-cols-[1fr_minmax(0,26rem)] lg:gap-16 lg:py-24">
    <div>
      <p class="eyebrow text-olive-500">
        Cape Coral &middot; Lee, Charlotte &amp; Collier Counties
      </p>

      <h1 class="mt-5 font-display text-5xl leading-[1.05] tracking-tight text-olive-900 sm:text-6xl lg:text-7xl">
        {business.tagline}
      </h1>

      <p class="mt-6 max-w-xl text-lg leading-relaxed text-olive-700">
        A family-owned shutter company in Cape Coral. We come to your home with samples, design your
        shutters with you and measure for your quote. They are then built, final-measured and installed by
        <strong class="font-semibold text-olive-900">{manufacturer.name}</strong> of {manufacturer.city},
        who have been making shutters here for over {manufacturer.yearsInBusiness} years.
      </p>

      <p class="mt-4 max-w-xl leading-relaxed text-olive-700">
        Shutters are the only thing we do.
      </p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a
          href="#quote"
          data-cta="hero-quote"
          class="inline-flex items-center justify-center rounded-full bg-olive-600 px-7 py-3.5 text-base font-semibold text-ivory-50 transition hover:bg-olive-700"
        >
          Book a free in-home quote
        </a>
        <a
          href={`tel:${business.phoneHref}`}
          data-cta="hero-call"
          class="inline-flex items-center justify-center rounded-full border border-olive-300 px-7 py-3.5 text-base font-semibold text-olive-800 transition hover:bg-ivory-200"
        >
          Call or text {business.phone}
        </a>
      </div>

      <p class="mt-4 text-sm text-olive-500">
        Already have measurements? We will give you a ballpark over the phone — no home visit required.
      </p>

      <ul class="mt-10 grid grid-cols-2 gap-x-4 gap-y-4 text-sm text-olive-700 sm:gap-x-8 sm:gap-y-3">
        {
          proof.map((lines) => (
            <li class="flex items-start gap-2 sm:gap-2.5">
              <svg aria-hidden="true" viewBox="0 0 20 20" class="mt-0.5 h-4 w-4 shrink-0 text-olive-600" fill="currentColor">
                <path
                  fill-rule="evenodd"
                  d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 9.7a1 1 0 1 1 1.4-1.4l3.8 3.8 6.8-6.8a1 1 0 0 1 1.4 0z"
                  clip-rule="evenodd"
                />
              </svg>
              <span class="block text-balance">
                {lines.map((line, i) => (
                  <span class="block sm:inline">{i > 0 ? ' ' : ''}{line}</span>
                ))}
                {/* Hand-drawn underline: stretched to the column so the four facts
                    share one baseline rather than four ragged ones. */}
                <svg
                  aria-hidden="true"
                  viewBox="0 0 120 6"
                  preserveAspectRatio="none"
                  class="mt-1.5 block h-1.5 w-full text-gold-500"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                >
                  <path d="M1.5 4.4c14.6-1.9 29.4-2.7 44.3-2.4 12.8.3 25.6 1.1 38.4 1.3 11.9.2 23.7-.4 35.4-1.9" />
                </svg>
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    {/* One image element serving two layouts: full-bleed background behind the copy on
        mobile, framed card in the second column from lg up. Same download either way. */}
    <div class="absolute inset-0 -z-10 lg:relative lg:z-auto">
      <Image
        src={heroImage}
        alt="White plantation shutters over a lake view in a Southwest Florida home, louvers angled open"
        widths={[420, 640, 828, 1200]}
        sizes="(min-width: 1024px) 26rem, 100vw"
        loading="eager"
        fetchpriority="high"
        class="h-full w-full object-cover lg:h-auto lg:rounded-2xl lg:shadow-lg lg:ring-1 lg:ring-olive-900/10"
      />
      <div
        aria-hidden="true"
        class="absolute inset-0 bg-gradient-to-b from-ivory-100/85 via-ivory-100/80 to-ivory-100/70 lg:hidden"
      >
      </div>
      <p class="mt-3 hidden text-xs text-olive-500 lg:block">
        A recent install, photographed by the owner.
      </p>
    </div>
  </div>
</section>

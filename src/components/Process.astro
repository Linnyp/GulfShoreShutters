---
import { process } from '../data/site';
---

<section id="process" class="bg-ivory-50 py-20 md:py-28">
  <div class="container-page">
    <div class="max-w-2xl" data-reveal>
      <p class="eyebrow text-olive-500">How It Works</p>
      <h2 class="mt-4 font-display text-4xl leading-tight tracking-tight text-olive-900 sm:text-5xl">
        Five steps, no surprises
      </h2>
    </div>

    <ol class="mt-14 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-5" data-reveal-group>
      {
        process.map((item) => (
          <li data-reveal class="border-t-2 border-gold-400 pt-6">
            <span class="font-display text-3xl text-gold-700">{item.step}</span>
            <h3 class="mt-3 font-display text-xl text-olive-900">{item.title}</h3>
            <p class="mt-3 leading-relaxed text-olive-700">{item.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

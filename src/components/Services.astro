---
import { Image } from 'astro:assets';
import { services, materials, pricing } from '../data/site';

/**
 * Icon artwork, inlined so a single `currentColor` fill takes the tile's text colour.
 *
 * The files in `icons/inline` are generated from the traced originals in `icons/` by
 * `scripts/normalize-icons.mjs` — do not hand-edit them, edit the source and re-run it.
 *
 * `services[].icon` names stay as they are in data/site.ts; this maps them onto the
 * artwork. `phone` has no traced counterpart yet, so it falls back to the solid handset
 * already used in the header, which matches the weight of the traced set.
 */
const inlineIcons = import.meta.glob<string>('../assets/icons/inline/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});

const iconArtwork: Record<string, string> = {
  shutter: 'garage',
  arch: 'measure',
  shield: 'shield',
  tag: 'price-tag',
  ruler: 'conversation',
};

const solidPhone =
  '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">' +
  '<path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.58 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.46.57 3.6a1 1 0 0 1-.25 1z"/></svg>';

const iconMarkup = (name: string) => {
  const file = iconArtwork[name];
  if (!file) return solidPhone;
  const svg = inlineIcons[`../assets/icons/inline/${file}.svg`];
  if (!svg) throw new Error(`Icon artwork not found: ${file}.svg — run scripts/normalize-icons.mjs`);
  return svg;
};

/**
 * Bento layout for the six service cards, indexed to match `services` in data/site.ts.
 *
 * The tiles are placed by the grid's own auto-flow rather than explicit line numbers, so
 * the spans below have to stay in DOM order to land as intended on a four-column grid:
 *
 *   ┌───────────────┬───────────────┐   0  feature, 2×2 — the whole positioning in one tile
 *   │               ├───────────────┤   1  wide
 *   │       0       │       1       │   2  wide
 *   │               ├───────────────┤   3  small, gold — the published price
 *   ├───────┬───────┼───────────────┤   4  small
 *   │   3   │   4   │       5       │   5  wide
 *   └───────┴───────┴───────────────┘
 *
 * That is exactly twelve cells, so the block ends square with no ragged trailing gap.
 * Reorder `services` and this grid needs re-checking — the two long bodies (1 and 2) are
 * in wide tiles on purpose, and the two shortest (3 and 4) in the narrow ones.
 */
const bento = [
  { span: 'sm:col-span-2 lg:col-span-2 lg:row-span-2', tone: 'feature' },
  { span: 'sm:col-span-2 lg:col-span-2', tone: 'plain' },
  { span: 'sm:col-span-2 lg:col-span-2', tone: 'plain' },
  { span: '', tone: 'accent' },
  { span: '', tone: 'plain' },
  { span: 'sm:col-span-2 lg:col-span-2', tone: 'plain' },
] as const;

const toneClasses = {
  // pb-24 reserves the strip the louver motif sits in, so the lines never run through the
  // copy on narrow screens where the tile is only as tall as its text.
  feature: 'relative isolate overflow-hidden bg-olive-900 pb-24 text-ivory-100 ring-1 ring-olive-900',
  accent: 'bg-gold-500/15 ring-1 ring-gold-500/50',
  plain: 'bg-ivory-100/70 ring-1 ring-olive-100 transition duration-300 hover:-translate-y-0.5 hover:ring-olive-300',
} as const;

const cards = services.map((service, index) => ({ ...service, ...bento[index] }));

/* Same pattern as Gallery: the data file carries filenames, resolution happens here so
   Astro can fingerprint and optimize the textures. */
const textures = import.meta.glob<{ default: ImageMetadata }>('../assets/material-*.jpg', {
  eager: true,
});

const materialCards = materials.map((material) => {
  const entry = textures[`../assets/${material.file}`];
  if (!entry) throw new Error(`Material texture not found in src/assets: ${material.file}`);
  return { ...material, texture: entry.default };
});
---

<section id="shutters" class="bg-ivory-50 py-20 md:py-28">
  <div class="container-page">
    <div class="max-w-2xl" data-reveal>
      <p class="eyebrow text-olive-500">What We Do</p>
      <h2 class="mt-4 font-display text-4xl leading-tight tracking-tight text-olive-900 sm:text-5xl">
        A specialist, not a catalogue
      </h2>

    </div>

    <div class="mt-14 grid gap-4 sm:grid-cols-2 sm:gap-5 lg:grid-cols-4" data-reveal-group>
      {
        cards.map((card) => (
          <article
            data-reveal
            class:list={[
              'flex flex-col rounded-3xl p-6 sm:p-7',
              toneClasses[card.tone],
              card.span,
            ]}
          >
            {/* No chip behind the icon — the artwork sits straight on the tile, in the CTA
                olive. The dark feature tile is the exception: olive-600 on olive-900 is
                about 1.6:1, so it takes the gold the tile already uses. */}
            <span
              class:list={[
                'block [&>svg]:h-full [&>svg]:w-full',
                card.tone === 'feature' ? 'h-16 w-16 text-gold-400' : 'h-12 w-12 text-olive-600',
              ]}
              set:html={iconMarkup(card.icon)}
            />

            {/* The rate gets to be a number rather than a sentence: it is the one fact on
                this page a homeowner is actually shopping on. */}
            {card.tone === 'accent' && (
              <p class="mt-5 font-display text-4xl leading-none tracking-tight text-gold-700">
                ${pricing.low}&ndash;${pricing.high}
              </p>
            )}

            <h3
              class:list={[
                'font-display',
                card.tone === 'accent' ? 'mt-2' : 'mt-5',
                card.tone === 'feature' ? 'text-3xl text-ivory-50 sm:text-4xl' : 'text-2xl text-olive-900',
              ]}
            >
              {card.title}
            </h3>
            <p
              class:list={[
                'mt-3 leading-relaxed',
                card.tone === 'feature' ? 'max-w-md text-lg text-olive-200' : 'text-olive-700',
              ]}
            >
              {card.body}
            </p>

            {/* Same tilted-louver motif as the section dividers, so the feature tile reads
                as part of the page rather than a stray dark box. */}
            {card.tone === 'feature' && (
              <svg
                aria-hidden="true"
                viewBox="0 0 320 120"
                preserveAspectRatio="none"
                class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-24 w-full text-gold-400"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
              >
                {[0, 1, 2, 3, 4].map((step) => (
                  <line
                    x1="0"
                    y1={112 - step * 17}
                    x2="320"
                    y2={64 - step * 17}
                    opacity={Math.max(0.06, 0.3 - step * 0.055)}
                  />
                ))}
              </svg>
            )}
          </article>
        ))
      }
    </div>

    <div class="mt-20 grid gap-10 lg:grid-cols-[minmax(0,22rem)_1fr] lg:gap-16">
      <div data-reveal>
        <p class="eyebrow text-olive-500">Materials</p>
        <h3 class="mt-4 font-display text-3xl leading-tight tracking-tight text-olive-900 sm:text-4xl">
          Three choices, and we will tell you which room needs which
        </h3>
        <p class="mt-5 leading-relaxed text-olive-700">
          Finishes are Sherwin-Williams paint colours plus custom stains matched to your existing millwork.
          Vinyl does not offer equivalent options, which is exactly why it is the right call in some rooms
          and the wrong call in others.
        </p>
      </div>

      <dl class="grid gap-5 sm:grid-cols-3" data-reveal-group>
        {
          materialCards.map((material) => (
            <div data-reveal class="relative isolate overflow-hidden rounded-2xl border border-olive-100 p-6">
              <Image
                src={material.texture}
                alt=""
                aria-hidden="true"
                widths={[400, 700]}
                sizes="(min-width: 1024px) 22rem, (min-width: 640px) 30vw, 90vw"
                loading="lazy"
                class="absolute inset-0 -z-10 h-full w-full object-cover"
              />
              <div class="absolute inset-0 -z-10 bg-ivory-50/60" />
              <dt>
                <span class="eyebrow text-gold-700">{material.label}</span>
                <span class="mt-2 block font-display text-2xl text-olive-900">{material.name}</span>
              </dt>
              <dd class="mt-3 leading-relaxed text-olive-800">{material.body}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

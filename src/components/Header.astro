---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { business } from '../data/site';

const links = [
  { href: '#about', label: 'About' },
  { href: '#shutters', label: 'Shutters' },
  { href: '#pricing', label: 'Pricing' },
  { href: '#gallery', label: 'Our Work' },
  { href: '#process', label: 'How It Works' },
  { href: '#faq', label: 'FAQ' },
];
---

<header class="sticky top-0 z-40 border-b border-olive-100 bg-ivory-50/95 backdrop-blur">
  <div class="container-page flex h-16 items-center justify-between gap-4 md:h-20">
    <a href="#main" class="shrink-0">
      <Image
        src={logo}
        alt={business.name}
        widths={[240, 360]}
        sizes="120px"
        loading="eager"
        class="h-11 w-auto md:h-14"
      />
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-7 lg:flex">
      {
        links.map((link) => (
          <a href={link.href} class="text-sm font-medium text-olive-700 transition hover:text-olive-900">
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      <a
        href={`tel:${business.phoneHref}`}
        data-cta="header-call"
        class="inline-flex items-center gap-2 rounded-full border border-olive-200 px-3 py-2 text-sm font-semibold text-olive-800 transition hover:bg-olive-50"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor">
          <path
            d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.58 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.46.57 3.6a1 1 0 0 1-.25 1z"
          ></path>
        </svg>
        <span class="hidden sm:inline">{business.phone}</span>
        <span class="sm:hidden">Call</span>
      </a>

      <a
        href="#quote"
        data-cta="header-quote"
        class="hidden rounded-full bg-olive-600 px-4 py-2 text-sm font-semibold text-ivory-50 transition hover:bg-olive-700 sm:inline-flex"
      >
        Free Quote
      </a>

      <button
        type="button"
        id="nav-toggle"
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="inline-flex h-10 w-10 items-center justify-center rounded-md text-olive-800 lg:hidden"
      >
        <span class="sr-only">Toggle navigation menu</span>
        <svg aria-hidden="true" viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" aria-label="Mobile" hidden class="border-t border-olive-100 bg-ivory-50 lg:hidden">
    <ul class="container-page flex flex-col py-2">
      {
        links.map((link) => (
          <li>
            <a href={link.href} class="block py-3 text-base font-medium text-olive-800">
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <a href="#quote" class="block py-3 text-base font-semibold text-olive-600">Get a Free Quote</a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('mobile-nav');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    nav?.toggleAttribute('hidden', open);
  });

  nav?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) {
      toggle?.setAttribute('aria-expanded', 'false');
      nav.setAttribute('hidden', '');
    }
  });
</script>

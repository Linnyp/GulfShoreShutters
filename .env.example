# Copy to .env for local dev; `npm run preview` (wrangler dev) reads it.
# Production (Cloudflare Workers — see README "Setup checklist"):
#   - PUBLIC_* keys are read at build time: set as Workers Builds build variables.
#   - Everything else is read by the Worker at runtime: `npx wrangler secret put <NAME>`.
#     Plain-text variables set only in the dashboard are removed on the next deploy.

# Public — inlined into the built HTML, safe to expose.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Secrets — server-side only, never referenced from src/.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Where leads are delivered, and the verified sender domain in Resend.
LEAD_TO_EMAIL=owner@gulfshoreshutters.com
LEAD_FROM_EMAIL=Gulfshore Shutters <website@gulfshoreshutters.com>
